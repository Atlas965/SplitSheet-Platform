# =============================================================================
# SplitSheet — Environment variable NAMES only (never commit real secrets)
# Copy to `.env` for local Development. For Preview use `.env.preview.example`.
# =============================================================================
#
# Environments:
#   Development  — Cursor / laptop (`LOCAL_DEV=true`, Stripe TEST)
#   Preview      — Vercel Preview (or Fly preview) + Preview Neon + Stripe TEST + OIDC
#   Production   — Vercel Production / long-running host + Prod Neon + Stripe LIVE
#
# Auth: keep Replit OIDC code available; for Preview/Production prefer AUTH_PROVIDER=oidc.
# Vercel: Express is exported from root `server.ts` (Fluid/serverless). Local/Fly still
# use `server/index.ts` + listen().
# =============================================================================

# ── Shared required ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# NEON_DATABASE_URL=   # alternate name accepted by the app
# Prefer Neon *pooled* connection string on Vercel.

SESSION_SECRET=replace-with-unique-secret-min-32-chars
APP_URL=http://localhost:5000
NODE_ENV=development
PORT=5000

# ── Development (Cursor) ──────────────────────────────────────────────────────
LOCAL_DEV=true
AUTH_PROVIDER=local
# Stripe TEST only in Development
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # optional with Stripe CLI
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...            # test Price IDs
# STRIPE_LABEL_PRICE_ID=price_...

# ── Preview (Martin review / Vercel Preview) — also see `.env.preview.example` ─
# Use a DEDICATED Preview Neon database (never Production).
# LOCAL_DEV=false
# AUTH_PROVIDER=oidc
# APP_URL=https://YOUR-DEPLOYMENT.vercel.app
# SESSION_SECRET=unique-preview-secret-not-used-elsewhere
# OIDC_ISSUER=https://YOUR_IDP/...
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://YOUR-DEPLOYMENT.vercel.app/api/callback
# STRIPE_SECRET_KEY=sk_test_...            # TEST mode only
# VITE_STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # Preview webhook endpoint
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# SKIP_BOOT_MIGRATIONS=true                # set automatically when VERCEL=1
# CRON_SECRET=replace-with-preview-cron-secret

# ── Production (do NOT use Preview secrets) ───────────────────────────────────
# Separate Neon, unique SESSION_SECRET, Stripe LIVE keys,
# and live webhook secrets belong only on the Production host dashboard.
# Prefer AUTH_PROVIDER=social with Google/Apple/GitHub/Microsoft credentials.

# ── Auth0 Universal Login (recommended long-term IdP) ─────────────────────────
# AUTH_PROVIDER=auth0
# APP_URL=https://splitsheet.ca
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_AUDIENCE=                    # optional API audience
# AUTH0_BASE_URL=https://splitsheet.ca   # optional; defaults to APP_URL
#
# Auth0 Application type: Regular Web Application
# Allowed Callback URLs:
#   https://splitsheet.ca/api/auth/auth0/callback
#   http://localhost:5000/api/auth/auth0/callback
# Allowed Logout URLs:
#   https://splitsheet.ca
#   http://localhost:5000
# Allowed Web Origins: https://splitsheet.ca
# Enable Google / Username-Password / MFA in Auth0 Dashboard → Authentication.
#
# Dual-run: keep AUTH_PROVIDER=social + GOOGLE_* until Auth0 is verified, then switch.

# ── Social login (direct providers; use while migrating to Auth0) ─────────────
# AUTH_PROVIDER=social
# APP_URL=https://splitsheet.ca
#
# Production break-glass only (passwordless /api/login). Prefer Auth0 or social OAuth.
# ALLOW_LOCAL_AUTH_IN_PRODUCTION=true
#
# Optional: allow linking a social/Auth0 login to an existing account
# when the IdP asserts a verified email. Default off (safer against takeover).
# ALLOW_EMAIL_ACCOUNT_LINKING=true
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client (type: Web application)
# Authorized JavaScript origins: https://splitsheet.ca
# Authorized redirect URI: https://splitsheet.ca/api/auth/google/callback
# In Vercel: paste ID/secret with NO spaces around = and NO wrapping quotes.
# Error 401 invalid_client = wrong/deleted client ID, or quotes included in the env value.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Apple Developer → Services ID + Key (.p8)
# Return URL: https://splitsheet.ca/api/auth/apple/callback
# APPLE_CLIENT_ID=          # Services ID
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#
# GitHub OAuth App → callback https://splitsheet.ca/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# Microsoft Entra app → redirect https://splitsheet.ca/api/auth/microsoft/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# ── Optional: Replit OIDC (retain for Replit hosting; not required on Vercel) ─
# AUTH_PROVIDER=replit
# REPL_ID=
# REPLIT_DOMAINS=
# ISSUER_URL=https://replit.com/oidc

# ── Optional services ─────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# FIELD_ENCRYPTION_SECRET=
# PLATFORM_FEE_BPS=250
# ENABLE_SERVER_PDF=false
# ENABLE_PAYOUT_RECONCILE=false            # in-process timer (Fly/local only)
# CRON_SECRET=                             # required for Vercel Cron reconcile
# SKIP_BOOT_MIGRATIONS=false               # true on Vercel (or rely on VERCEL=1)
# SKIP_STRIPE_PREFLIGHT_EXIT=false         # true to avoid process.exit on preflight
#
# Object storage: only needed if reviewing profile/file uploads.
# Martin agreement/split/rights review does not require uploads.
# OBJECT_STORAGE_PROVIDER=s3
# S3_BUCKET=
# AWS_REGION=
# GCS_BUCKET=
