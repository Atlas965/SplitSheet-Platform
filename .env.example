# Copy to `.env` and fill in values before launch.

# ── Required (all environments) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Or use NEON_DATABASE_URL (Replit export name) — either works.
# NEON_DATABASE_URL=

SESSION_SECRET=generate-a-long-random-string-min-32-chars
APP_URL=http://localhost:5000

# ── Payments (required for billing) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_LABEL_PRICE_ID=price_...

# ── Local development (Cursor / Windows) ────────────────────────────────────
PORT=5000
LOCAL_DEV=true
NODE_ENV=development

# ── Production auth (Replit OIDC) — set NODE_ENV=production, LOCAL_DEV=false ─
# REPL_ID=your-replit-repl-id
# REPLIT_DOMAINS=your-app.replit.app
# ISSUER_URL=https://replit.com/oidc

# ── CoPilot AI (recommended for launch — offline fallback works without it) ─
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── Optional security & storage ─────────────────────────────────────────────
# FIELD_ENCRYPTION_SECRET=
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=
# PLATFORM_FEE_BPS=250

# ── Production launch checklist ─────────────────────────────────────────────
# [ ] SESSION_SECRET — strong random string (never use dev default)
# [ ] APP_URL — public HTTPS URL (used in contributor confirmation links)
# [ ] LOCAL_DEV=false
# [ ] NODE_ENV=production
# [ ] OPENAI_API_KEY — for live CoPilot responses
# [ ] STRIPE_WEBHOOK_SECRET — for subscription events
# [ ] REPL_ID + REPLIT_DOMAINS — for OIDC auth (or your auth provider)
