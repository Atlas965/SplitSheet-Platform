# =============================================================================
# SplitSheet — PREVIEW (Martin review) environment template
# Variable NAMES / placeholders only. Never commit a filled copy.
#
# Copy to Vercel Preview env / secrets manager — do NOT commit `.env.preview`.
# Preferred host: Vercel Preview (Express via root server.ts).
# Alternate long-running host: Fly (see fly.preview.toml).
# =============================================================================

NODE_ENV=production
LOCAL_DEV=false
PORT=5000

# Public HTTPS origin of the Preview deployment (confirmation links + OIDC)
APP_URL=https://YOUR-PREVIEW.vercel.app

# Unique Preview secret — must differ from Development and Production
SESSION_SECRET=replace-with-unique-preview-secret-min-32-chars

# Dedicated Preview Neon database ONLY (never Production connection string)
# Prefer Neon pooled connection string for Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@PREVIEW-HOST/neondb?sslmode=require

# Portable OIDC for Preview (Replit auth code remains in repo but is not used here)
AUTH_PROVIDER=oidc
OIDC_ISSUER=https://YOUR_IDP_ISSUER
OIDC_CLIENT_ID=preview-client-id
OIDC_CLIENT_SECRET=preview-client-secret
OIDC_REDIRECT_URI=https://YOUR-PREVIEW.vercel.app/api/callback

# Stripe TEST mode only — never sk_live_ / pk_live_ in Preview
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...          # test prices
# STRIPE_LABEL_PRICE_ID=price_...

# Vercel: skip boot migrations (also automatic when VERCEL=1). Run db:migrate against Preview Neon before/alongside deploy.
SKIP_BOOT_MIGRATIONS=true
SKIP_STRIPE_PREFLIGHT_EXIT=true

# Keep in-process reconcile OFF; use Vercel Cron + CRON_SECRET instead
ENABLE_PAYOUT_RECONCILE=false
CRON_SECRET=replace-with-unique-preview-cron-secret
ENABLE_SERVER_PDF=false

# Optional Copilot (non-production key recommended)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Uploads not required for Martin agreement/split/rights review
# OBJECT_STORAGE_PROVIDER=s3
