# =============================================================================
# SplitSheet — Vercel Preview / Production (Martin review) env template
# Names/placeholders only. Never commit real secrets.
# =============================================================================

NODE_ENV=production
LOCAL_DEV=false

# Public HTTPS origin (your Vercel URL)
APP_URL=https://split-sheet-platform.vercel.app

SESSION_SECRET=replace-with-unique-secret-min-32-chars

# Neon pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# NEON_DATABASE_URL=   # alternate — also accepted

# Operator login on Vercel (no Replit OIDC required)
# Visit https://YOUR-HOST/api/login → redirects to Dashboard at /
AUTH_PROVIDER=local

# Stripe TEST only while reviewing
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

SKIP_BOOT_MIGRATIONS=true
ENABLE_SERVER_PDF=false

# Optional
# OPENAI_API_KEY=
